# ── VOUCH environment ────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env or an Agentic Wallet key.

# --- Database (Supabase Postgres) ---
# Pooled connection string from the Supabase dashboard (Settings → Database).
DATABASE_URL=postgres://user:password@host:5432/postgres

# --- API server ---
PORT=8080
NODE_ENV=development
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:4173

# --- x402 payments (paid /check endpoint) ---
# The ASP wallet that receives per-call payments. Public address only here.
X402_RECIPIENT=0xYourASPWallet
X402_PRICE_USDC=0.004
X402_ASSET=USDC
X402_NETWORK=xlayer
# When true, /check accepts requests without payment (local dev / demo fallback).
X402_BYPASS=true

# --- Indexer (X Layer chain reads) ---
XLAYER_RPC_URL=https://rpc.xlayer.tech
# Settlement contract on X Layer — fill in from §3 validation.
SETTLEMENT_CONTRACT=0x0000000000000000000000000000000000000000
# Block to start indexing from (marketplace genesis). 0 = from deploy block.
INDEXER_START_BLOCK=0
# How many blocks to pull per batch.
INDEXER_BATCH_SIZE=2000
# Poll interval in ms between batches once caught up.
INDEXER_POLL_MS=5000

# --- OKX.AI listing ---
# The Agent ID assigned once the ASP is listed. Used in docs/SUBMISSION.md.
VOUCH_AGENT_ID=
