{
  "name": "vouch",
  "version": "0.1.0",
  "private": true,
  "description": "VOUCH — counterparty reputation ASP for the OKX.AI agent marketplace",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/indexer"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:indexer": "npm run dev --workspace apps/indexer",
    "dev:web": "python -m http.server 4173 --directory apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
